# Настройки для повторных попыток получения Telegram-клиента в фоновой задаче
MAX_CLIENT_ACQUIRE_RETRIES=3     # 1 начальная + 2 ретрая = 3 всего попыток
CLIENT_ACQUIRE_RETRY_DELAY=60    # 60 секунд = 1 минута